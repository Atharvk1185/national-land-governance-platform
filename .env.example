# National Land Governance Platform Environment Variables
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Optional PostgreSQL with PostGIS & pgvector (falls back to high-speed SQLite FTS5 if empty)
DATABASE_URL=postgresql://nlgirp_user:nlgirp_secure_password_2025@localhost:5432/land_governance_db

# Optional Redis Cache
REDIS_URL=redis://localhost:6379/0

# AI / LLM Configuration (Options: rule_based, openai, gemini, local)
LLM_PROVIDER=rule_based
OPENAI_API_KEY=
GEMINI_API_KEY=

# Security
JWT_SECRET_KEY=national_land_governance_secure_jwt_token_key_2025
